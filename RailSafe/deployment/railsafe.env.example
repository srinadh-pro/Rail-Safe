# Copy to railsafe.env.local and fill with real values.
# Never commit railsafe.env.local or put these values in application.properties.

# Aiven MySQL
# Set DB_URL to the endpoint for this deployment. Either form works: the full
# JDBC URL below, or the short mysql://user:pass@host:port/db URI from Aiven
# (converted to JDBC automatically at startup). Credentials in the URI are used
# only when DB_USERNAME/DB_PASSWORD are absent; AIVEN_TRUSTSTORE_PASSWORD below
# is always passed separately as a driver property.
# DB_URL=jdbc:mysql://host:port/db?sslMode=VERIFY_CA&trustCertificateKeyStoreUrl=classpath:aiven-truststore.p12&trustCertificateKeyStoreType=PKCS12&serverTimezone=UTC
DB_USERNAME=avnadmin
DB_PASSWORD=REPLACE_WITH_AIVEN_DB_PASSWORD
AIVEN_TRUSTSTORE_PASSWORD=REPLACE_WITH_TRUSTSTORE_PASSWORD

# First Super Admin bootstrap (only used when no SUPER_ADMIN exists)
RAILSAFE_SUPER_ADMIN_EMAIL=superadmin@railsafe.demo
RAILSAFE_SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Keep demo shortcut cards hidden in production
RAILSAFE_DEMO_ACCOUNTS_ENABLED=false

# --- HTTPS / reverse-proxy hardening -------------------------------------------
# Leave these commented for local HTTP development. When deploying behind the
# TLS proxy in deployment/nginx-railsafe.conf, uncomment them so cookies are
# Secure, HSTS is emitted, and the lockout sees the real client IP.
# On Render/Vercel, leave RAILSAFE_SERVER_ADDRESS unset: Render injects PORT and
# the app binds 0.0.0.0 automatically. Set the other three in the Render dashboard.
# RAILSAFE_SERVER_ADDRESS=127.0.0.1
# RAILSAFE_COOKIE_SECURE=true
# RAILSAFE_HSTS_ENABLED=true
# RAILSAFE_HSTS_MAX_AGE_SECONDS=31536000
# Spring Boot values: none | native | framework
# RAILSAFE_FORWARD_HEADERS_STRATEGY=framework

# --- Login abuse control -------------------------------------------------------
# Lock a client IP out after this many failed sign-in attempts, for this long.
RAILSAFE_LOGIN_MAX_ATTEMPTS=10
RAILSAFE_LOGIN_LOCK_MINUTES=15

# --- Schema management ---------------------------------------------------------
# Default is "update". After verifying the live schema matches the entities,
# set this to "validate" so the app fails fast on drift. Never use create/create-drop.
# RAILSAFE_DDL_AUTO=validate
